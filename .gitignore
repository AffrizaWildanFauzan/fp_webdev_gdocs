cat > .gitignore << 'EOF'
# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
.env.development

# Build
dist/
build/
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# MongoDB
dump/
*.bson
*.metadata.json

# Miscellaneous
*.tmp
*.temp
EOF